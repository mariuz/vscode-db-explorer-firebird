{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2020",
    "outDir": "out",
    "lib": [
      "ES2019"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "types": [
      "node",
      "mocha"
    ],
    "strict": true
  },
  "include": [
    "src/test/e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
