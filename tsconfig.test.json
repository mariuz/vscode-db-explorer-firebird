{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2020",
    "outDir": "out",
    "lib": [
      "ES2019"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "types": [
      "node",
      "mocha"
    ],
    "strict": true
  },
  "include": [
    "src/shared/sql-splitter.ts",
    "src/shared/sql-analysis.ts",
    "src/shared/sql-formatter.ts",
    "src/shared/changelog-notice.ts",
    "src/shared/object-explorer-filter.ts",
    "src/shared/parameterized-query.ts",
    "src/shared/sql-linter.ts",
    "src/shared/driver.ts",
    "src/shared/connection-pool.ts",
    "src/shared/ssh-tunnel.ts",
    "src/shared/workspace-config.ts",
    "src/shared/global.ts",
    "src/shared/utils.ts",
    "src/shared/credential-store.ts",
    "src/shared/flat-file-parser.ts",
    "src/shared/notebook-render.ts",
    "src/logger/logger.ts",
    "src/schema-diff/schema-diff.ts",
    "src/bookmarks/bookmark-provider.ts",
    "src/query-history/query-history-provider.ts",
    "src/task-panel/task-tracker.ts",
    "src/connection-sharing/index.ts",
    "src/connection-sharing/permissions.ts",
    "src/connection-sharing/run-query.ts",
    "src/shared/gbak-options.ts",
    "src/shared/connection-health.ts",
    "src/shared/identifier-quoting.ts",
    "src/shared/quick-queries.ts",
    "src/shared/executable-probe.ts",
    "src/shared/db-tools.ts",
    "src/sql-notebook/export.ts",
    "src/schema-designer/schema-graph.ts",
    "src/shared/queries.ts",
    "src/copilot/schema-context.ts",
    "src/copilot/json-extraction.ts",
    "src/language-server/completionProvider.ts",
    "src/language-server/firebird-reserved.ts",
    "src/shared/schema-support.ts",
    "src/shared/engine-version.ts",
    "src/language-server/hover-model.ts",
    "src/language-server/symbol-model.ts",
    "src/language-server/definition-model.ts",
    "src/interfaces/**/*.ts",
    "src/test/**/*.ts",
    "src/test/paging.test.ts",
    "src/result-view/index.ts",
    "src/test/result-view-paging.test.ts",
    "src/test/webview-coverage-scripts.test.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
