{
  "$schema": "https://json.schemastore.org/c8rc.json",
  "src": ["out"],
  "excludeAfterRemap": true,
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/test/**",
    "src/interfaces/**",
    "**/node_modules/**"
  ],
  "reporter": ["text-summary", "lcov", "cobertura"],
  "reports-dir": "coverage/unit",
  "temp-directory": "coverage/.tmp-unit",

  "statements": 70,
  "branches": 90,
  "functions": 62,
  "lines": 70
}
